{
  "name": "@contentstack/cli-cm-branches",
  "description": "Contentstack CLI plugin to do branches operations",
  "version": "2.0.0-beta.10",
  "author": "Contentstack",
  "bugs": "https://github.com/contentstack/cli-plugins/issues",
  "dependencies": {
    "@contentstack/cli-command": "~2.0.0-beta.10",
    "@contentstack/cli-utilities": "~2.0.0-beta.11",
    "@oclif/core": "^4.11.4",
    "chalk": "^5.6.2",
    "just-diff": "^6.0.2",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^9.0.0",
    "eslint": "^10.5.0",
    "eslint-config-oclif": "^6.0.62",
    "mocha": "10.8.2",
    "nyc": "^15.1.0",
    "oclif": "^4.23.8",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "pnpm compile && oclif manifest && oclif readme",
    "clean": "rm -rf ./lib ./node_modules tsconfig.tsbuildinfo oclif.manifest.json",
    "compile": "tsc -b tsconfig.json",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "pnpm compile && oclif manifest && oclif readme",
    "version": "oclif readme && git add README.md",
    "pretest": "tsc -p test",
    "test": "mocha --forbid-only \"test/unit/**/*.test.ts\" --exit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "eslint \"src/**/*.ts\" --fix"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/messages",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/contentstack/cli",
  "keywords": [
    "contentstack",
    "cli",
    "plugin"
  ],
  "license": "MIT",
  "main": "./lib/commands/cm/stacks/export.js",
  "types": "./types/index.d.ts",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "csdx",
    "repositoryPrefix": "<%- repo %>/blob/main/packages/contentstack-branches/<%- commandPath %>"
  },
  "csdxConfig": {
    "shortCommandName": {
      "cm:branches:create": "BRCR",
      "cm:branches:delete": "BRDEL",
      "cm:branches:diff": "BRDIF",
      "cm:branches:merge": "BRMRG",
      "cm:branches:merge-status": "BRMST",
      "cm:branches": "BRLS"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentstack/cli-plugins.git",
    "directory": "packages/contentstack-branches"
  }
}
