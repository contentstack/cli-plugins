{
  "name": "@contentstack/cli-audit",
  "version": "2.0.0",
  "description": "Contentstack audit plugin",
  "author": "Contentstack CLI",
  "homepage": "https://github.com/contentstack/cli",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "audit": "./bin/run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentstack/cli-plugins.git",
    "directory": "packages/contentstack-audit"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@contentstack/cli-command": "~2.0.0",
    "@contentstack/cli-utilities": "~2.0.0",
    "@oclif/core": "^4.11.14",
    "chalk": "^5.6.2",
    "fast-csv": "^4.3.6",
    "fs-extra": "^11.3.6",
    "lodash": "^4.18.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.20",
    "@types/chai": "^4.3.20",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.50",
    "chai": "^4.5.0",
    "eslint": "^10.6.0",
    "eslint-config-oclif": "^6.0.175",
    "eslint-config-oclif-typescript": "^3.1.14",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0",
    "oclif": "^4.23.27",
    "shx": "^0.4.0",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "oclif": {
    "bin": "csdx",
    "commands": "./lib/commands",
    "topicSeparator": ":",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "repositoryPrefix": "<%- repo %>/blob/main/packages/contentstack-audit/<%- commandPath %>"
  },
  "scripts": {
    "build": "pnpm compile && oclif manifest && oclif readme",
    "lint": "eslint \"src/**/*.ts\"",
    "postpack": "rm -f oclif.manifest.json",
    "compile": "tsc -b tsconfig.json",
    "prepack": "pnpm compile && oclif manifest && oclif readme",
    "test": "mocha --timeout 10000 --forbid-only --file test/unit/logger-config.js \"test/unit/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "clean": "rm -rf ./lib ./node_modules tsconfig.tsbuildinfo oclif.manifest.json",
    "format": "eslint \"src/**/*.ts\" --fix"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": "https://github.com/contentstack/cli-plugins/issues",
  "keywords": [
    "oclif"
  ]
}
