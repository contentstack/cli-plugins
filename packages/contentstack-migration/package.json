{
  "name": "@contentstack/cli-migration",
  "version": "2.0.0-beta.16",
  "author": "@contentstack",
  "bugs": "https://github.com/contentstack/cli-plugins/issues",
  "dependencies": {
    "@contentstack/cli-command": "~2.0.0-beta.10",
    "@contentstack/cli-utilities": "~2.0.0-beta.11",
    "@oclif/core": "^4.11.4",
    "async": "^3.2.6",
    "callsites": "^3.1.0",
    "cardinal": "^2.1.1",
    "chalk": "^5.6.2",
    "concat-stream": "^2.0.0",
    "listr": "^0.14.3",
    "rxjs": "^6.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.18",
    "@types/mocha": "^8.2.3",
    "@types/node": "^14.18.63",
    "chai": "^4.5.0",
    "eslint": "^10.5.0",
    "eslint-config-oclif": "^6.0.62",
    "jsdoc-to-markdown": "^8.0.3",
    "mocha": "^10.8.2",
    "nock": "^13.5.6",
    "nyc": "^15.1.0",
    "oclif": "^4.23.8",
    "sinon": "^21.1.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/contentstack/cli",
  "keywords": [
    "oclif-plugin"
  ],
  "license": "MIT",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "csdx",
    "repositoryPrefix": "<%- repo %>/blob/main/packages/contentstack-migration/<%- commandPath %>"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentstack/cli-plugins.git",
    "directory": "packages/contentstack-migration"
  },
  "scripts": {
    "build": "pnpm compile && oclif manifest && oclif readme",
    "postpack": "rm -f oclif.manifest.json",
    "generate-api-ref-md-doc": "nyc jsdoc2md ./src/modules/*.ts > ./docs/api-reference.md || true",
    "compile": "tsc -b tsconfig.json",
    "prepack": "pnpm compile && oclif manifest && oclif readme",
    "pretest": "tsc -p test",
    "test": "mocha --forbid-only \"test/unit/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "clean": "rm -rf ./lib ./node_modules tsconfig.tsbuildinfo oclif.manifest.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "eslint \"src/**/*.ts\" --fix"
  },
  "csdxConfig": {
    "shortCommandName": {
      "cm:stacks:migration": "MGRTN"
    }
  }
}
